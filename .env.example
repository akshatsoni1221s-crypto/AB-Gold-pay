# ═════════════════════════════════════════════════════════
# GoldPay ERP - Environment Configuration
# ═════════════════════════════════════════════════════════
# SECURITY: Variables without NEXT_PUBLIC_ prefix are
# SERVER-SIDE ONLY. NEVER expose them in client code.
# All API keys stay in server-side API routes and never
# reach the browser.
# ═════════════════════════════════════════════════════════
# All external services are OPTIONAL with free tiers:
# - Cloudinary: 25GB free (image/video storage)
# - AWS S3: 5GB free tier (alternative storage)
# - SMTP/Gmail: Free app passwords (email notifications)
# The system runs fully without these configured.
# ═════════════════════════════════════════════════════════

# -- Database (Required) --
DATABASE_URL="postgresql://goldpay_user:goldpay_password@localhost:5432/goldpay_erp"

# -- Redis (Required for caching & rate limiting) --
REDIS_URL="redis://localhost:6379"

# -- Authentication (Required) --
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-min-32-chars"
JWT_SECRET="change-this-to-another-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# -- Cloudinary (Free tier: 25GB storage, optional) --
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -- AWS S3 (Free tier: 5GB for 12 months, optional) --
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# -- Email/SMTP (Gmail free tier, optional) --
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@goldpay.com"

# -- Backup (Local) --
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# -- Public vars (Safe to expose to browser) --
NEXT_PUBLIC_APP_NAME="GoldPay ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="AB GoldPay"
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_COMPANY_GST=""
NEXT_PUBLIC_COMPANY_PHONE=""
NEXT_PUBLIC_COMPANY_EMAIL=""

# -- Rate Limiting --
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -- Encryption (Sensitive data at rest) --
ENCRYPTION_KEY=""
